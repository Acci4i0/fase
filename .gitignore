# macOS
.DS_Store

# Il sito è HTML/CSS/JS puro e non ha un passo di build: si apre aprendo
# index.html. package.json e vite erano un tentativo abbandonato e non sono
# referenziati da nessuna pagina.
node_modules/
package.json
package-lock.json

# Originali fotografici ad alta risoluzione (≈ 58 MB). Nel sito entrano le
# versioni web derivate, che stanno in img/soluzioni/.
img/settori/
img/applicazioni/

# Libreria fotografica del committente (≈ 40 MB di PNG a nome UUID) più i
# render CAD scaricati da fasemec.com. Servono come archivio di lavoro; nel
# sito entrano le versioni rimontate su grigio in img/su-grigio/.
# Le poche usate direttamente sono escluse dall'esclusione qui sotto.
img/immagini/*
